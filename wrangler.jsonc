{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mpscexam",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "routes": [
    { "pattern": "mpscexam.in", "custom_domain": true },
    { "pattern": "www.mpscexam.in", "custom_domain": true },
    { "pattern": "friday.mpscexam.in", "custom_domain": true },
    { "pattern": "grammahsuladhikari.in", "custom_domain": true },
    { "pattern": "www.grammahsuladhikari.in", "custom_domain": true },
    { "pattern": "talathibharti.in", "custom_domain": true },
    { "pattern": "www.talathibharti.in", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mpscexam-db",
      "database_id": "c81409fd-6f8f-475f-914b-39b9a0af7269"
    }
  ]
}
